  "cards": [
    { "id": "ja-kana-001", "type": "vocab", "prompt": "**あ** ・ **ア**", "answer": "a", "explanation": "发音接近中文「啊」，但更短。常见词：あめ（雨 / ame）。", "tags": ["五十音", "あ行"] },
    { "id": "ja-kana-002", "type": "vocab", "prompt": "**い** ・ **イ**", "answer": "i", "explanation": "发音接近「衣」。常见词：いぬ（犬 / inu）。", "tags": ["五十音", "あ行"] },
    { "id": "ja-kana-003", "type": "vocab", "prompt": "**う** ・ **ウ**", "answer": "u", "explanation": "嘴唇放松，接近「乌」但更轻。常见词：うみ（海 / umi）。", "tags": ["五十音", "あ行"] },
    { "id": "ja-kana-004", "type": "vocab", "prompt": "**え** ・ **エ**", "answer": "e", "explanation": "接近「诶」。常见词：えき（駅 / eki）。", "tags": ["五十音", "あ行"] },
    { "id": "ja-kana-005", "type": "vocab", "prompt": "**お** ・ **オ**", "answer": "o", "explanation": "接近「哦」。常见词：おちゃ（お茶 / ocha）。", "tags": ["五十音", "あ行"] },
    { "id": "ja-kana-006", "type": "vocab", "prompt": "**か** ・ **カ**", "answer": "ka", "explanation": "送气要轻。常见词：かさ（傘 / kasa）。", "tags": ["五十音", "か行"] },
    { "id": "ja-kana-007", "type": "vocab", "prompt": "**き** ・ **キ**", "answer": "ki", "explanation": "常见词：き（木 / ki）。", "tags": ["五十音", "か行"] },
    { "id": "ja-kana-008", "type": "vocab", "prompt": "**く** ・ **ク**", "answer": "ku", "explanation": "常见词：くつ（靴 / kutsu）。", "tags": ["五十音", "か行"] },
    { "id": "ja-kana-009", "type": "vocab", "prompt": "**け** ・ **ケ**", "answer": "ke", "explanation": "常见词：けいたい（携帯 / keitai）。", "tags": ["五十音", "か行"] },
    { "id": "ja-kana-010", "type": "vocab", "prompt": "**こ** ・ **コ**", "answer": "ko", "explanation": "常见词：こども（子供 / kodomo）。", "tags": ["五十音", "か行"] },
    { "id": "ja-kana-011", "type": "vocab", "prompt": "**さ** ・ **サ**", "answer": "sa", "explanation": "常见词：さかな（魚 / sakana）。", "tags": ["五十音", "さ行"] },
    { "id": "ja-kana-012", "type": "vocab", "prompt": "**し** ・ **シ**", "answer": "shi", "explanation": "读「西」，不是「斯」。常见词：しろ（白 / shiro）。", "tags": ["五十音", "さ行"] },
    { "id": "ja-kana-013", "type": "vocab", "prompt": "**す** ・ **ス**", "answer": "su", "explanation": "常见词：すし（寿司 / sushi）。", "tags": ["五十音", "さ行"] },
    { "id": "ja-kana-014", "type": "vocab", "prompt": "**せ** ・ **セ**", "answer": "se", "explanation": "常见词：せかい（世界 / sekai）。", "tags": ["五十音", "さ行"] },
    { "id": "ja-kana-015", "type": "vocab", "prompt": "**そ** ・ **ソ**", "answer": "so", "explanation": "常见词：そら（空 / sora）。", "tags": ["五十音", "さ行"] },
    { "id": "ja-kana-016", "type": "vocab", "prompt": "**た** ・ **タ**", "answer": "ta", "explanation": "常见词：たまご（卵 / tamago）。", "tags": ["五十音", "た行"] },
    { "id": "ja-kana-017", "type": "vocab", "prompt": "**ち** ・ **チ**", "answer": "chi", "explanation": "读「七」，不是「吃」。常见词：ちいさい（小さい / chiisai）。", "tags": ["五十音", "た行"] },
    { "id": "ja-kana-018", "type": "vocab", "prompt": "**つ** ・ **ツ**", "answer": "tsu", "explanation": "「ts」+「乌」，像中文「次」但更短。常见词：つき（月 / tsuki）。", "tags": ["五十音", "た行"] },
    { "id": "ja-kana-019", "type": "vocab", "prompt": "**て** ・ **テ**", "answer": "te", "explanation": "常见词：て（手 / te）。", "tags": ["五十音", "た行"] },
    { "id": "ja-kana-020", "type": "vocab", "prompt": "**と** ・ **ト**", "answer": "to", "explanation": "常见词：とり（鳥 / tori）。", "tags": ["五十音", "た行"] },
    { "id": "ja-kana-021", "type": "vocab", "prompt": "**な** ・ **ナ**", "answer": "na", "explanation": "常见词：なつ（夏 / natsu）。", "tags": ["五十音", "な行"] },
    { "id": "ja-kana-022", "type": "vocab", "prompt": "**に** ・ **ニ**", "answer": "ni", "explanation": "常见词：にく（肉 / niku）。", "tags": ["五十音", "な行"] },
    { "id": "ja-kana-023", "type": "vocab", "prompt": "**ぬ** ・ **ヌ**", "answer": "nu", "explanation": "常见词：ぬの（布 / nuno）。", "tags": ["五十音", "な行"] },
    { "id": "ja-kana-024", "type": "vocab", "prompt": "**ね** ・ **ネ**", "answer": "ne", "explanation": "常见词：ねこ（猫 / neko）。", "tags": ["五十音", "な行"] },
    { "id": "ja-kana-025", "type": "vocab", "prompt": "**の** ・ **ノ**", "answer": "no", "explanation": "常见词：のり（海苔 / nori）；也常作助词「的」。", "tags": ["五十音", "な行"] },
    { "id": "ja-kana-026", "type": "vocab", "prompt": "**は** ・ **ハ**", "answer": "ha", "explanation": "常见词：はな（花 / hana）。注意：作助词时读 wa。", "tags": ["五十音", "は行"] },
    { "id": "ja-kana-027", "type": "vocab", "prompt": "**ひ** ・ **ヒ**", "answer": "hi", "explanation": "常见词：ひと（人 / hito）。", "tags": ["五十音", "は行"] },
    { "id": "ja-kana-028", "type": "vocab", "prompt": "**ふ** ・ **フ**", "answer": "fu", "explanation": "介于「呼」和「夫」之间，不咬唇。常见词：ふゆ（冬 / fuyu）。", "tags": ["五十音", "は行"] },
    { "id": "ja-kana-029", "type": "vocab", "prompt": "**へ** ・ **ヘ**", "answer": "he", "explanation": "常见词：へや（部屋 / heya）；作助词时也读 e。", "tags": ["五十音", "は行"] },
    { "id": "ja-kana-030", "type": "vocab", "prompt": "**ほ** ・ **ホ**", "answer": "ho", "explanation": "常见词：ほし（星 / hoshi）。", "tags": ["五十音", "は行"] },
    { "id": "ja-kana-031", "type": "vocab", "prompt": "**ま** ・ **マ**", "answer": "ma", "explanation": "常见词：まど（窓 / mado）。", "tags": ["五十音", "ま行"] },
    { "id": "ja-kana-032", "type": "vocab", "prompt": "**み** ・ **ミ**", "answer": "mi", "explanation": "常见词：みず（水 / mizu）。", "tags": ["五十音", "ま行"] },
    { "id": "ja-kana-033", "type": "vocab", "prompt": "**む** ・ **ム**", "answer": "mu", "explanation": "常见词：むし（虫 / mushi）。", "tags": ["五十音", "ま行"] },
    { "id": "ja-kana-034", "type": "vocab", "prompt": "**め** ・ **メ**", "answer": "me", "explanation": "常见词：め（目 / me）。", "tags": ["五十音", "ま行"] },
    { "id": "ja-kana-035", "type": "vocab", "prompt": "**も** ・ **モ**", "answer": "mo", "explanation": "常见词：もり（森 / mori）。", "tags": ["五十音", "ま行"] },
    { "id": "ja-kana-036", "type": "vocab", "prompt": "**や** ・ **ヤ**", "answer": "ya", "explanation": "常见词：やま（山 / yama）。", "tags": ["五十音", "や行"] },
    { "id": "ja-kana-037", "type": "vocab", "prompt": "**ゆ** ・ **ユ**", "answer": "yu", "explanation": "常见词：ゆき（雪 / yuki）。", "tags": ["五十音", "や行"] },
    { "id": "ja-kana-038", "type": "vocab", "prompt": "**よ** ・ **ヨ**", "answer": "yo", "explanation": "常见词：よる（夜 / yoru）。", "tags": ["五十音", "や行"] },
    { "id": "ja-kana-039", "type": "vocab", "prompt": "**ら** ・ **ラ**", "answer": "ra", "explanation": "舌尖轻弹一下，不是中文的「拉」。常见词：さくら（桜 / sakura）。", "tags": ["五十音", "ら行"] },
    { "id": "ja-kana-040", "type": "vocab", "prompt": "**り** ・ **リ**", "answer": "ri", "explanation": "常见词：りんご（林檎 / ringo）。", "tags": ["五十音", "ら行"] },
    { "id": "ja-kana-041", "type": "vocab", "prompt": "**る** ・ **ル**", "answer": "ru", "explanation": "常见词：くるま（車 / kuruma）。", "tags": ["五十音", "ら行"] },
    { "id": "ja-kana-042", "type": "vocab", "prompt": "**れ** ・ **レ**", "answer": "re", "explanation": "常见词：れい（例 / rei）。", "tags": ["五十音", "ら行"] },
    { "id": "ja-kana-043", "type": "vocab", "prompt": "**ろ** ・ **ロ**", "answer": "ro", "explanation": "常见词：ろく（六 / roku）。", "tags": ["五十音", "ら行"] },
    { "id": "ja-kana-044", "type": "vocab", "prompt": "**わ** ・ **ワ**", "answer": "wa", "explanation": "常见词：わたし（私 / watashi）。", "tags": ["五十音", "わ行"] },
    { "id": "ja-kana-045", "type": "vocab", "prompt": "**を** ・ **ヲ**", "answer": "o", "explanation": "只作助词，罗马音写 o（也有教材写 wo）。例：本を読む（ほんをよむ / hon o yomu）。", "tags": ["五十音", "わ行"] },
    { "id": "ja-kana-046", "type": "vocab", "prompt": "**ん** ・ **ン**", "answer": "n", "explanation": "不单独成词，只出现在词中或词尾。例：ほん（本 / hon）。", "tags": ["五十音", "撥音"] }
  ]
